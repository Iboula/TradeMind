{
  "ConnectionStrings": {
    "KnowledgeHub": "Host=localhost;Port=5432;Database=trademind;Username=trademind;Password=trademind"
  },
  "AI": {
    "Provider": "OpenAI",
    "OpenAI": {
      "ApiKey": "",
      "ChatModel": "gpt-4.1-mini",
      "EmbeddingModel": "text-embedding-3-small"
    }
  },
  "TradeMind": {
    "Api": {
      "Correlation": {
        "MaximumLength": 64
      },
      "Idempotency": {
        "Enabled": true,
        "TtlMinutes": 15,
        "MaximumKeyLength": 128
      },
      "PayloadLimits": {
        "MaximumBodyBytes": 5242880
      },
      "Timeouts": {
        "RequestTimeoutSeconds": 30
      },
      "OpenApi": {
        "Enabled": true,
        "EnableUi": false
      },
      "Security": {
        "EnableHttpsRedirection": true,
        "EnableSecurityHeaders": true
      },
      "Database": {
        "MigrateOnStartup": false
      }
    },
    "Persistence": {
      "Provider": "InMemory",
      "ConnectionStringName": "TradeMind",
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false,
      "ApplyMigrationsOnStartup": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
