{
  "TradeMind": {
    "Brokers": {
      "MetaTrader5": {
        "TerminalBridge": {
          "Enabled": true,
          "Urls": "https://127.0.0.1:5001",
          "ProtocolVersion": "1.0",
          "TerminalVersion": "mql5-agent",
          "DemoOnly": true,
          "AllowLive": false,
          "AllowInsecureDemoTransport": false,
          "MaxConcurrentRequests": 4,
          "RequestTimeoutSeconds": 30,
          "MaxPayloadBytes": 65536,
          "MaximumClockSkewSeconds": 30,
          "ReplayWindowSeconds": 120,
          "AuthenticationMode": "SignedToken",
          "TokenConfigurationKey": "MT5_TERMINAL_BRIDGE_TOKEN",
          "AgentTokenConfigurationKey": "MT5_TERMINAL_AGENT_TOKEN",
          "RequireAgent": true,
          "AgentHeartbeatTimeoutSeconds": 15,
          "MinimumSupportedTerminalBuild": 3000,
          "MaximumSupportedTerminalBuild": 99999,
          "SupportedTerminalArchitecture": "x64",
          "Mql5PollTimeoutSeconds": 25,
          "Mql5PollIntervalSeconds": 1,
          "EnableWriteTests": false,
          "WriteTestSymbol": "EURUSD",
          "WriteTestMinimumVolume": 0.01
        }
      }
    }
  }
}
